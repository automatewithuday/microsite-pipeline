# =============================================================================
# Core switches — these decide which keys below are actually required.
# =============================================================================
LLM_PROVIDER=api             # api (your ANTHROPIC_API_KEY) | claude_cli (Claude subscription)

# =============================================================================
# REQUIRED with the default above (api)
# =============================================================================
ANTHROPIC_API_KEY=           # https://console.anthropic.com/settings/keys — drives research + TAM/ICP/signals

# =============================================================================
# OPTIONAL — each key unlocks more of the deck. Absent = that step skips
# cleanly and the microsite renders lighter (never fabricated). Run
# `npx tsx scripts/doctor.ts` to see exactly what will run vs skip.
# =============================================================================

# Person + company enrichment, founders, SDR headcount (steps 01/02/06):
DEEPLINE_API_KEY=            # https://code.deepline.com (account > API keys)

# Traffic + ad libraries + LinkedIn company fallback (steps 04/05/02):
APIFY_TOKEN=                # https://console.apify.com/settings/integrations
APIFY_ACTOR_SIMILARWEB=     # traffic (step 04) — pin an actor from https://apify.com/store
APIFY_ACTOR_META_ADS=apify/facebook-ads-scraper
APIFY_ACTOR_GOOGLE_ADS=parseforge/google-ads-scraper
APIFY_ACTOR_LINKEDIN_ADS=ivanvs/linkedin-ad-library-scraper
APIFY_ACTOR_LI_COMPANY=     # LinkedIn company scraper (step 02 fallback)

# CRM detect / brand colors / logo fallback (steps 03/08/09 — these also run
# keyless via a plain fetch; Firecrawl is only the fallback):
FIRECRAWL_API_KEY=          # https://www.firecrawl.dev/app/api-keys

# Logo lookup (step 09; the Firecrawl/plain-fetch fallback is used if absent):
BRANDFETCH_API_KEY=         # https://developers.brandfetch.com

# Alternative research backends. Default (claude) uses the LLM_PROVIDER above
# with web search and needs no extra key:
RESEARCH_PROVIDER=claude    # claude | parallel | perplexity
PARALLEL_API_KEY=           # required only if RESEARCH_PROVIDER=parallel — https://platform.parallel.ai
PERPLEXITY_API_KEY=         # required only if RESEARCH_PROVIDER=perplexity — https://www.perplexity.ai/settings/api

# =============================================================================
# LLM tuning (LLM_PROVIDER=api) — override the model tiers if you like.
# =============================================================================
# ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5      # extraction (TAM)
# ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6    # synthesis (research, ICP, signals)

# =============================================================================
# Local state — override output locations.
# =============================================================================
# OUTPUT_DIR=output          # where {leadId}.pdf / .html are written
# LOCAL_DB_PATH=local.db      # SQLite file

# =============================================================================
# Render
# =============================================================================
# RENDER_STRICT=false         # true = require qualified + logo + a brand color to render
#                             # (the operator ruleset; default is the looser public gate)

# =============================================================================
# Local viewer (scripts/serve.ts)
# =============================================================================
# PORT=4321                   # viewer port
# HOST=127.0.0.1              # bind address; 0.0.0.0 exposes it to your network

# =============================================================================
# Claude subscription CLI (only when LLM_PROVIDER=claude_cli)
# =============================================================================
# CLAUDE_CLI_PATH=claude      # path to the headless `claude` binary (defaults to PATH)
